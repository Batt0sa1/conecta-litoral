---
const valores = [
  'Compromiso social',
  'Cercanía',
  'Transparencia',
  'Colaboración',
  'Creatividad',
  'Respeto',
  'Inclusión',
  'Responsabilidad',
  'Empatía',
  'Innovación social',
];
---

<div class="text-center">
    <p class="text-gray-500 mb-12 font-body">Los principios que guían nuestra comunidad.</p>

    <div class="flex flex-wrap justify-center gap-3">
      {valores.map(v => (
        <span class="bg-white border border-primary/20 text-azul font-body text-sm px-5 py-2.5 rounded-full hover:border-primary hover:text-primary transition">
          {v}
        </span>
      ))}
    </div>
</div>
