---
// Carrusel de portada. Para cambiar o agregar diapositivas, edita `diapositivas`.
// Las fotos actuales son de 320×320 px, por eso se muestran al lado del texto y no a pantalla completa.
// Con fotos más grandes (ideal 1600 px de ancho) se puede pasar a un carrusel de ancho completo.
const base = import.meta.env.BASE_URL;

const diapositivas = [
  {
    titulo: 'Conectando ideas, personas y territorios',
    texto: 'Emprendimiento, servicios y alojamientos del litoral, en un solo lugar y con el respaldo de la fundación.',
    imagen: 'images/foto-grupal-de-todos-los-fundadores.webp',
    alt: 'Foto grupal de los fundadores de Conecta Litoral',
    botones: [
      { texto: 'Ver Guía del Litoral', href: '#guia', principal: true },
      { texto: 'Publica tu aviso', href: '#publicar' },
    ],
  },
  {
    titulo: 'Capacitación y asesorías para emprendedores',
    texto: 'Charlas, talleres y asesorías profesionales para que tu negocio crezca con una base sólida.',
    imagen: 'images/persona-hablando-en-charla.webp',
    alt: 'Charla de capacitación para emprendedores',
    botones: [
      { texto: 'Ver asesorías', href: '#asesorias', principal: true },
      { texto: 'Conversemos', href: '#contacto' },
    ],
  },
  {
    titulo: 'Una fundación del litoral, para el litoral',
    texto: 'Conoce quiénes somos, qué hacemos y los valores que guían a nuestra comunidad.',
    imagen: 'images/foto-de-fundadores.webp',
    alt: 'Fundadores de Conecta Litoral',
    botones: [
      { texto: 'Conoce la fundación', href: '#fundacion', principal: true },
    ],
  },
];
---

<section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-sky-50 via-white to-white"
  aria-roledescription="carrusel" aria-label="Destacados de Conecta Litoral">
  <div class="absolute -top-24 -left-24 w-72 h-72 bg-secondary/15 rounded-full" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -right-24 w-96 h-96 bg-lila/10 rounded-full" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-4">
    <div class="overflow-hidden">
    <div class="carrusel-pista flex transition-transform duration-700 ease-out motion-reduce:transition-none">
      {diapositivas.map((d, i) => (
        <div class="carrusel-diapo w-full shrink-0 py-12 sm:py-16 md:py-20"
          role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${diapositivas.length}`}
          aria-hidden={i === 0 ? 'false' : 'true'}>
          <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
            <div class="order-2 md:order-1 text-center md:text-left">
              {i === 0
                ? <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight mb-4">{d.titulo}</h1>
                : <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight mb-4">{d.titulo}</h2>}
              <p class="font-body text-base sm:text-lg text-gray-600 mb-8 max-w-xl mx-auto md:mx-0">{d.texto}</p>
              <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
                {d.botones.map(b => (
                  <a href={b.href} tabindex={i === 0 ? undefined : -1}
                    class={b.principal
                      ? 'bg-primary text-white font-heading font-semibold px-7 py-3 rounded-full text-base hover:bg-azul transition shadow-sm text-center'
                      : 'bg-white border-2 border-primary text-primary font-heading font-semibold px-7 py-3 rounded-full text-base hover:bg-primary hover:text-white transition text-center'}>
                    {b.texto}
                  </a>
                ))}
              </div>
            </div>
            <div class="order-1 md:order-2 flex justify-center">
              <div class="relative">
                <div class="absolute -inset-3 bg-gradient-to-br from-secondary/30 to-lila/30 rounded-[2rem] rotate-3" aria-hidden="true"></div>
                <img src={`${base}${d.imagen}`} alt={d.alt} width="320" height="320"
                  loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined}
                  class="relative w-56 h-56 sm:w-72 sm:h-72 md:w-80 md:h-80 object-cover rounded-3xl shadow-lg" />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    </div>

    <!-- Controles -->
    <div class="flex items-center justify-center gap-4 pb-8">
      <button type="button" class="carrusel-ant w-10 h-10 rounded-full bg-white border border-sky-100 shadow-sm text-primary hover:bg-sky-50 transition" aria-label="Diapositiva anterior">‹</button>
      <div class="flex gap-2">
        {diapositivas.map((_, i) => (
          <button type="button" class="carrusel-punto w-2.5 h-2.5 rounded-full bg-primary/20 transition-all aria-[current=true]:bg-primary aria-[current=true]:w-7"
            aria-label={`Ir a la diapositiva ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-i={i}></button>
        ))}
      </div>
      <button type="button" class="carrusel-sig w-10 h-10 rounded-full bg-white border border-sky-100 shadow-sm text-primary hover:bg-sky-50 transition" aria-label="Diapositiva siguiente">›</button>
      <button type="button" class="carrusel-pausa ml-2 text-xs text-gray-400 hover:text-primary" aria-label="Pausar carrusel">Pausar</button>
    </div>
  </div>
</section>

<script>
  const raiz = document.getElementById('inicio')!;
  const pista = raiz.querySelector<HTMLElement>('.carrusel-pista')!;
  const diapos = [...raiz.querySelectorAll<HTMLElement>('.carrusel-diapo')];
  const puntos = [...raiz.querySelectorAll<HTMLButtonElement>('.carrusel-punto')];
  const botonPausa = raiz.querySelector<HTMLButtonElement>('.carrusel-pausa')!;
  const INTERVALO = 7000;
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let actual = 0;
  let pausadoPorUsuario = sinMovimiento; // si la persona prefiere menos movimiento, no avanza solo
  let encima = false;
  let temporizador: number | undefined;

  function ir(i: number) {
    actual = (i + diapos.length) % diapos.length;
    pista.style.transform = `translateX(-${actual * 100}%)`;
    diapos.forEach((d, j) => {
      const visible = j === actual;
      d.setAttribute('aria-hidden', String(!visible));
      d.querySelectorAll<HTMLAnchorElement>('a').forEach(a => (a.tabIndex = visible ? 0 : -1));
    });
    puntos.forEach((p, j) => p.setAttribute('aria-current', String(j === actual)));
  }

  function programar() {
    clearInterval(temporizador);
    if (!pausadoPorUsuario && !encima && diapos.length > 1) {
      temporizador = window.setInterval(() => ir(actual + 1), INTERVALO);
    }
  }

  function actualizarPausa() {
    botonPausa.textContent = pausadoPorUsuario ? 'Reproducir' : 'Pausar';
    botonPausa.setAttribute('aria-label', pausadoPorUsuario ? 'Reproducir carrusel' : 'Pausar carrusel');
    programar();
  }

  raiz.querySelector('.carrusel-ant')!.addEventListener('click', () => { ir(actual - 1); programar(); });
  raiz.querySelector('.carrusel-sig')!.addEventListener('click', () => { ir(actual + 1); programar(); });
  puntos.forEach(p => p.addEventListener('click', () => { ir(Number(p.dataset.i)); programar(); }));
  botonPausa.addEventListener('click', () => { pausadoPorUsuario = !pausadoPorUsuario; actualizarPausa(); });

  // Se detiene mientras el mouse o el foco del teclado están sobre el carrusel.
  raiz.addEventListener('mouseenter', () => { encima = true; programar(); });
  raiz.addEventListener('mouseleave', () => { encima = false; programar(); });
  raiz.addEventListener('focusin', () => { encima = true; programar(); });
  raiz.addEventListener('focusout', () => { encima = false; programar(); });

  // Deslizar con el dedo en celulares.
  let inicioX: number | null = null;
  pista.addEventListener('touchstart', e => { inicioX = e.touches[0].clientX; }, { passive: true });
  pista.addEventListener('touchend', e => {
    if (inicioX === null) return;
    const dx = e.changedTouches[0].clientX - inicioX;
    if (Math.abs(dx) > 50) { ir(actual + (dx < 0 ? 1 : -1)); programar(); }
    inicioX = null;
  });

  ir(0);
  actualizarPausa();
</script>
