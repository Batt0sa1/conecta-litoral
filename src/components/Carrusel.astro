---
// Carrusel de portada: solo imágenes.
// - Las predeterminadas (src/data/carrusel.ts) vienen en el HTML.
// - Si se editó el carrusel desde el panel /admin, se piden a /api/carrusel y reemplazan a las predeterminadas.
// - Cada foto se muestra completa (object-contain) sobre un fondo desenfocado de sí misma, así sirven
//   fotos horizontales, verticales y afiches sin recortarlos.
// - Solo se cargan la foto visible y la siguiente.
import { diapositivasPredeterminadas, type Diapositiva } from '../data/carrusel';

const base = import.meta.env.BASE_URL;
/** Fotos y páginas del sitio llevan el prefijo base (en Cloudflare es '/'); anclas y URLs externas, no. */
const ruta = (v: string) => (v.startsWith('/') && !v.startsWith('/api/') ? `${base}${v.slice(1)}` : v);
const externo = (v: string) => /^https?:\/\//i.test(v);
const total = diapositivasPredeterminadas.length;
const MARCO = 'relative block w-full aspect-[4/3] sm:aspect-[16/9] max-h-[72vh] rounded-3xl overflow-hidden shadow-lg bg-sky-100';
---

<section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-sky-50 via-white to-white pt-6 sm:pt-8"
  aria-roledescription="carrusel" aria-label="Imágenes de Conecta Litoral" data-base={base}>
  <h1 class="sr-only">Conecta Litoral: Guía del Litoral y fundación para emprendedores de Algarrobo y el litoral</h1>
  <div class="absolute -top-24 -left-24 w-72 h-72 bg-secondary/15 rounded-full" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -right-24 w-96 h-96 bg-lila/10 rounded-full" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4">
    <div class="overflow-hidden rounded-3xl">
      <div class="carrusel-pista flex transition-[transform,opacity] duration-700 ease-out motion-reduce:transition-none">
        {diapositivasPredeterminadas.map((d: Diapositiva, i) => {
          const Marco = d.enlace ? 'a' : 'div';
          return (
            <div class="carrusel-diapo w-full shrink-0" role="group" aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${total}`} aria-hidden={i === 0 ? 'false' : 'true'}>
              <Marco class={MARCO} href={d.enlace ? ruta(d.enlace) : undefined}
                target={d.enlace && externo(d.enlace) ? '_blank' : undefined}
                rel={d.enlace && externo(d.enlace) ? 'noopener noreferrer' : undefined}
                tabindex={d.enlace && i !== 0 ? -1 : undefined}>
                <img class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-60" alt="" aria-hidden="true"
                  data-src={ruta(d.imagen)} src={i === 0 ? ruta(d.imagen) : undefined} />
                <img class="carrusel-img relative w-full h-full object-contain" alt={d.alt}
                  data-src={ruta(d.imagen)} src={i === 0 ? ruta(d.imagen) : undefined}
                  fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
              </Marco>
            </div>
          );
        })}
      </div>
      <!-- Mientras se consulta si hay un carrusel editado desde el panel, se oculta (sin JavaScript se ve normal). -->
      <script is:inline>document.querySelector('#inicio .carrusel-pista').style.opacity = '0';</script>
    </div>

    <!-- Controles -->
    <div class="carrusel-controles flex items-center justify-center gap-4 py-6">
      <button type="button" class="carrusel-ant w-10 h-10 rounded-full bg-white border border-sky-100 shadow-sm text-primary hover:bg-sky-50 transition" aria-label="Imagen anterior">‹</button>
      <div class="carrusel-puntos flex gap-2">
        {diapositivasPredeterminadas.map((_, i) => (
          <button type="button" class="carrusel-punto w-2.5 h-2.5 rounded-full bg-primary/20 transition-all aria-[current=true]:bg-primary aria-[current=true]:w-7"
            aria-label={`Ir a la imagen ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-i={i}></button>
        ))}
      </div>
      <button type="button" class="carrusel-sig w-10 h-10 rounded-full bg-white border border-sky-100 shadow-sm text-primary hover:bg-sky-50 transition" aria-label="Imagen siguiente">›</button>
      <button type="button" class="carrusel-pausa ml-2 text-xs text-gray-400 hover:text-primary" aria-label="Pausar carrusel">Pausar</button>
    </div>
  </div>
</section>

<script>
  import type { Diapositiva } from '../data/carrusel';

  const raiz = document.getElementById('inicio')!;
  const base = raiz.dataset.base || '/';
  const pista = raiz.querySelector<HTMLElement>('.carrusel-pista')!;
  const contPuntos = raiz.querySelector<HTMLElement>('.carrusel-puntos')!;
  const controles = raiz.querySelector<HTMLElement>('.carrusel-controles')!;
  const botonPausa = raiz.querySelector<HTMLButtonElement>('.carrusel-pausa')!;
  const INTERVALO = 6000;
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MARCO = 'relative block w-full aspect-[4/3] sm:aspect-[16/9] max-h-[72vh] rounded-3xl overflow-hidden shadow-lg bg-sky-100';

  let diapos: HTMLElement[] = [];
  let puntos: HTMLButtonElement[] = [];
  let actual = 0;
  let pausadoPorUsuario = sinMovimiento; // si la persona prefiere menos movimiento, no avanza solo
  let encima = false;
  let temporizador: number | undefined;

  const ruta = (v: string) => (v.startsWith('/') && !v.startsWith('/api/') ? `${base}${v.slice(1)}` : v);

  /** Pone el `src` a las fotos de una diapositiva (se piden recién cuando hacen falta). */
  function cargarFotos(i: number) {
    diapos[(i + diapos.length) % diapos.length]?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach(img => {
      if (!img.getAttribute('src')) img.src = img.dataset.src!;
    });
  }

  function ir(i: number) {
    actual = (i + diapos.length) % diapos.length;
    pista.style.transform = `translateX(-${actual * 100}%)`;
    cargarFotos(actual);
    cargarFotos(actual + 1); // deja lista la siguiente
    diapos.forEach((d, j) => {
      const visible = j === actual;
      d.setAttribute('aria-hidden', String(!visible));
      d.querySelectorAll<HTMLAnchorElement>('a').forEach(a => (a.tabIndex = visible ? 0 : -1));
    });
    puntos.forEach((p, j) => p.setAttribute('aria-current', String(j === actual)));
  }

  function programar() {
    clearInterval(temporizador);
    if (!pausadoPorUsuario && !encima && diapos.length > 1) {
      temporizador = window.setInterval(() => ir(actual + 1), INTERVALO);
    }
  }

  function actualizarPausa() {
    botonPausa.textContent = pausadoPorUsuario ? 'Reproducir' : 'Pausar';
    botonPausa.setAttribute('aria-label', pausadoPorUsuario ? 'Reproducir carrusel' : 'Pausar carrusel');
    programar();
  }

  /** Toma las diapositivas y puntos que hay en la página y les conecta los eventos. */
  function vincular() {
    diapos = [...pista.querySelectorAll<HTMLElement>('.carrusel-diapo')];
    puntos = [...contPuntos.querySelectorAll<HTMLButtonElement>('.carrusel-punto')];
    puntos.forEach(p => p.addEventListener('click', () => { ir(Number(p.dataset.i)); programar(); }));
    controles.classList.toggle('invisible', diapos.length < 2);
    ir(0);
    actualizarPausa();
  }

  // ---------- Carrusel editado desde el panel ----------

  function crearDiapositiva(d: Diapositiva, i: number, total: number) {
    const diapo = document.createElement('div');
    diapo.className = 'carrusel-diapo w-full shrink-0';
    diapo.setAttribute('role', 'group');
    diapo.setAttribute('aria-roledescription', 'diapositiva');
    diapo.setAttribute('aria-label', `${i + 1} de ${total}`);
    // El enlace ya viene validado por la API (ancla, página del sitio o http/https); se revisa igual.
    const conEnlace = /^(#[a-z0-9-]+|\/[a-z0-9-]+\/|https?:\/\/)/i.test(d.enlace || '');
    const marco = document.createElement(conEnlace ? 'a' : 'div');
    marco.className = MARCO;
    if (marco instanceof HTMLAnchorElement) {
      marco.href = ruta(d.enlace);
      if (/^https?:/i.test(d.enlace)) { marco.target = '_blank'; marco.rel = 'noopener noreferrer'; }
    }
    const fondo = document.createElement('img');
    fondo.className = 'absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-60';
    fondo.alt = '';
    fondo.setAttribute('aria-hidden', 'true');
    const img = document.createElement('img');
    img.className = 'carrusel-img relative w-full h-full object-contain';
    img.alt = d.alt;
    img.decoding = 'async';
    fondo.dataset.src = img.dataset.src = ruta(d.imagen);
    marco.append(fondo, img);
    diapo.append(marco);
    return diapo;
  }

  function montar(lista: Diapositiva[]) {
    pista.replaceChildren(...lista.map((d, i) => crearDiapositiva(d, i, lista.length)));
    contPuntos.replaceChildren(...lista.map((_, i) => {
      const p = document.createElement('button');
      p.type = 'button';
      p.className = 'carrusel-punto w-2.5 h-2.5 rounded-full bg-primary/20 transition-all aria-[current=true]:bg-primary aria-[current=true]:w-7';
      p.dataset.i = String(i);
      p.setAttribute('aria-label', `Ir a la imagen ${i + 1}`);
      return p;
    }));
  }

  // ---------- Controles ----------

  raiz.querySelector('.carrusel-ant')!.addEventListener('click', () => { ir(actual - 1); programar(); });
  raiz.querySelector('.carrusel-sig')!.addEventListener('click', () => { ir(actual + 1); programar(); });
  botonPausa.addEventListener('click', () => { pausadoPorUsuario = !pausadoPorUsuario; actualizarPausa(); });

  // Se detiene mientras el mouse o el foco del teclado están sobre el carrusel.
  raiz.addEventListener('mouseenter', () => { encima = true; programar(); });
  raiz.addEventListener('mouseleave', () => { encima = false; programar(); });
  raiz.addEventListener('focusin', () => { encima = true; programar(); });
  raiz.addEventListener('focusout', () => { encima = false; programar(); });

  // Deslizar con el dedo en celulares.
  let inicioX: number | null = null;
  pista.addEventListener('touchstart', e => { inicioX = e.touches[0].clientX; }, { passive: true });
  pista.addEventListener('touchend', e => {
    if (inicioX === null) return;
    const dx = e.changedTouches[0].clientX - inicioX;
    if (Math.abs(dx) > 50) { ir(actual + (dx < 0 ? 1 : -1)); programar(); }
    inicioX = null;
  });

  // ---------- Inicio ----------

  let mostrado = false;
  function mostrar() {
    if (mostrado) return;
    mostrado = true;
    pista.style.opacity = '';
  }

  async function iniciar() {
    // Si la API tarda, se muestran las predeterminadas igual a los 1,2 s.
    const espera = setTimeout(mostrar, 1200);
    try {
      const res = await fetch('/api/carrusel', { headers: { Accept: 'application/json' } });
      if (res.ok) {
        const { diapositivas } = (await res.json()) as { diapositivas: Diapositiva[] | null };
        if (Array.isArray(diapositivas) && diapositivas.length) montar(diapositivas);
      }
    } catch {
      // Sin API (por ejemplo en `astro dev` o GitHub Pages): quedan las predeterminadas.
    }
    clearTimeout(espera);
    vincular();
    mostrar();
  }
  iniciar();
</script>
