---
// Guía del Litoral: directorio de alojamientos, restaurantes, servicios y emprendimientos.
// Los avisos reales se administran en /admin y se cargan desde /api/avisos al abrir la página.
// Mientras no haya avisos publicados (o si la API no responde) se muestran las tarjetas "Próximamente".
import { categorias } from '../data/categorias';

const avisos = categorias.map(c => ({
  categoria: c.id,
  nombre: c.ejemplo,
  sector: 'Algarrobo y litoral',
  descripcion: 'Próximamente publicaremos aquí avisos revisados por la fundación. ¡Sé de los primeros!',
}));

const nombreCategoria = Object.fromEntries(categorias.map(c => [c.id, c.nombre]));
const iconoCategoria = Object.fromEntries(categorias.map(c => [c.id, c.icon]));
---

<section id="guia" class="py-20 px-4 bg-gradient-to-b from-white to-sky-50"
  data-categorias={JSON.stringify(categorias.map(({ id, nombre, icon }) => ({ id, nombre, icon })))}>
  <div class="max-w-6xl mx-auto">
    <p class="text-center text-secondary font-heading font-semibold text-sm uppercase tracking-wider mb-2">Nuevo</p>
    <h2 class="font-heading text-3xl sm:text-4xl font-bold text-primary text-center mb-4">Guía del Litoral</h2>
    <p class="text-center text-gray-600 mb-10 font-body max-w-2xl mx-auto">
      Alojamientos, restaurantes, servicios y emprendimientos del litoral en un sitio confiable.
      Cada aviso es revisado por la Fundación Conecta Litoral antes de publicarse.
    </p>

    <!-- Sellos de confianza -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {['Avisos revisados por la fundación', 'Contacto directo por WhatsApp', 'Negocios y personas del litoral'].map(t => (
        <span class="inline-flex items-center gap-2 bg-white border border-sky-200 text-azul text-sm font-medium px-4 py-2 rounded-full shadow-sm">
          <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          {t}
        </span>
      ))}
    </div>

    <!-- Categorías / filtros -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-10" role="tablist" aria-label="Categorías de la guía">
      <button type="button" data-filtro="todos" aria-pressed="true"
        class="guia-filtro col-span-2 sm:col-span-3 lg:col-span-6 justify-self-center px-5 py-2 rounded-full text-sm font-heading font-semibold border transition">
        Ver todo
      </button>
      {categorias.map(c => (
        <button type="button" data-filtro={c.id} aria-pressed="false"
          class="guia-filtro flex flex-col items-center gap-2 text-center bg-white rounded-2xl p-4 border transition hover:shadow-md">
          <span class="text-secondary" set:html={c.icon} />
          <span class="font-heading text-sm font-semibold text-azul leading-tight">{c.nombre}</span>
        </button>
      ))}
    </div>

    <!-- Avisos -->
    <div id="guia-avisos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" aria-live="polite">
      {avisos.map(a => (
        <article data-categoria={a.categoria} data-ejemplo class="guia-aviso bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col border border-sky-100">
          <div class="h-32 flex items-center justify-center bg-gradient-to-br from-sky-100 to-violet-100 text-primary/50 relative">
            <span set:html={iconoCategoria[a.categoria]} class="scale-150" />
            <span class="absolute top-3 right-3 bg-white/90 text-xs font-medium text-gray-500 px-2.5 py-1 rounded-full">Próximamente</span>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <span class="self-start border border-secondary text-secondary text-xs font-medium px-2.5 py-0.5 rounded-full mb-3">
              {nombreCategoria[a.categoria]}
            </span>
            <h3 class="font-heading text-base font-bold text-azul leading-snug mb-1">{a.nombre}</h3>
            <p class="text-xs text-primary font-medium mb-3">📍 {a.sector}</p>
            <p class="font-body text-gray-500 text-sm leading-relaxed flex-1">{a.descripcion}</p>
            <div class="mt-5 pt-4 border-t border-gray-100">
              <a href="#publicar" class="inline-flex items-center gap-2 text-primary text-sm font-medium hover:underline">
                Publica tu aviso aquí →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p id="guia-vacio" class="hidden text-center text-gray-500 text-sm font-body bg-white border border-dashed border-sky-200 rounded-2xl py-10 px-4">
      Aún no hay avisos en esta categoría. <a href="#publicar" class="text-primary font-medium hover:underline">¡Publica el tuyo!</a>
    </p>

    <!-- Formulario: publicar aviso -->
    <div id="publicar" class="mt-16 bg-white border border-primary/15 rounded-2xl p-8 sm:p-10 shadow-sm scroll-mt-24">
      <h3 class="font-heading text-2xl font-bold text-primary text-center mb-2">¿Quieres publicar tu arriendo o negocio?</h3>
      <p class="text-gray-600 text-sm text-center mb-8 font-body max-w-xl mx-auto">
        Envíanos los datos y el equipo de la fundación te contactará para revisar y publicar tu aviso.
      </p>

      <form id="form-aviso" class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-azul text-sm font-medium mb-1.5" for="a-nombre">Tu nombre *</label>
          <input required id="a-nombre" name="nombre" type="text" placeholder="Tu nombre"
            class="w-full bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40" />
        </div>
        <div>
          <label class="block text-azul text-sm font-medium mb-1.5" for="a-telefono">Teléfono / WhatsApp *</label>
          <input required id="a-telefono" name="telefono" type="tel" placeholder="+56 9 1234 5678"
            class="w-full bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40" />
        </div>
        <div>
          <label class="block text-azul text-sm font-medium mb-1.5" for="a-categoria">Categoría *</label>
          <select required id="a-categoria" name="categoria"
            class="w-full bg-white border border-sky-200 text-gray-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
            <option value="" disabled selected>Selecciona una categoría</option>
            {categorias.map(c => <option value={c.nombre}>{c.nombre}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-azul text-sm font-medium mb-1.5" for="a-sector">Sector / comuna *</label>
          <input required id="a-sector" name="sector" type="text" placeholder="Ej: Mirasol, Algarrobo"
            class="w-full bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-azul text-sm font-medium mb-1.5" for="a-descripcion">Describe tu aviso *</label>
          <textarea required id="a-descripcion" name="descripcion" rows="3" placeholder="Nombre del negocio o propiedad, capacidad, horarios, qué ofreces…"
            class="w-full bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 resize-none"></textarea>
        </div>
        <div class="sm:col-span-2 flex items-start gap-3">
          <input required id="a-consent" name="consent" type="checkbox" class="mt-1 accent-primary w-4 h-4 shrink-0" />
          <label for="a-consent" class="text-gray-500 text-xs leading-relaxed">
            Acepto el tratamiento de mis datos personales conforme a la Ley 19.628 sobre Protección de la Vida Privada. Mis datos serán usados únicamente para gestionar mi aviso en la Guía del Litoral.
          </label>
        </div>
        <div class="sm:col-span-2">
          <button type="submit"
            class="w-full bg-primary text-white font-heading font-bold py-3.5 rounded-full text-base hover:bg-azul transition shadow">
            Enviar por WhatsApp
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { describirCaracteristicas, type Caracteristicas } from '../data/caracteristicas';

  interface AvisoPublico {
    id: string;
    categoria: string;
    nombre: string;
    sector: string;
    descripcion: string;
    whatsapp: string;
    web?: string;
    instagram?: string;
    fotos: string[];
    caracteristicas?: Caracteristicas;
  }

  const seccion = document.getElementById('guia') as HTMLElement;
  const contenedor = document.getElementById('guia-avisos') as HTMLElement;
  const vacio = document.getElementById('guia-vacio') as HTMLElement;
  const filtros = document.querySelectorAll<HTMLButtonElement>('.guia-filtro');
  const categorias: { id: string; nombre: string; icon: string }[] = JSON.parse(seccion.dataset.categorias || '[]');
  let filtroActual = 'todos';
  let hayAvisosReales = false;

  function aplicar(filtro: string) {
    filtroActual = filtro;
    filtros.forEach(b => {
      const activo = b.dataset.filtro === filtro;
      b.setAttribute('aria-pressed', String(activo));
      b.classList.toggle('border-primary', activo);
      b.classList.toggle('ring-2', activo);
      b.classList.toggle('ring-primary/30', activo);
      b.classList.toggle('border-sky-100', !activo);
      if (b.dataset.filtro === 'todos') {
        b.classList.toggle('bg-primary', activo);
        b.classList.toggle('text-white', activo);
        b.classList.toggle('bg-white', !activo);
        b.classList.toggle('text-primary', !activo);
      }
    });
    let visibles = 0;
    contenedor.querySelectorAll<HTMLElement>('.guia-aviso').forEach(a => {
      const ver = filtro === 'todos' || a.dataset.categoria === filtro;
      a.classList.toggle('hidden', !ver);
      if (ver) visibles++;
    });
    vacio.classList.toggle('hidden', !(hayAvisosReales && visibles === 0));
  }

  filtros.forEach(b => b.addEventListener('click', () => aplicar(b.dataset.filtro || 'todos')));
  aplicar('todos');

  // ---------- Avisos reales desde el panel ----------

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, clases = '', texto?: string) {
    const e = document.createElement(tag);
    if (clases) e.className = clases;
    if (texto !== undefined) e.textContent = texto;
    return e;
  }

  function galeria(aviso: AvisoPublico, cat?: { icon: string }) {
    const caja = el('div', 'relative h-48 bg-gradient-to-br from-sky-100 to-violet-100');
    if (aviso.fotos.length === 0) {
      const icono = el('div', 'h-full flex items-center justify-center text-primary/50');
      const span = el('span', 'scale-150');
      span.innerHTML = cat?.icon || ''; // SVG fijo del sitio, no viene del usuario
      icono.append(span);
      caja.append(icono);
      return caja;
    }
    const pista = el('div', 'h-full flex overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden');
    // Solo la portada lleva `src` (y con lazy: se pide al acercarse a la pantalla).
    // Las demás fotos se piden recién cuando la persona desliza la galería, para no gastar cuota de la API.
    const imgs = aviso.fotos.map((f, i) => {
      const img = el('img', 'h-full w-full shrink-0 snap-center object-cover');
      img.dataset.src = `/api/fotos/${encodeURIComponent(f)}`;
      img.alt = `${aviso.nombre} — foto ${i + 1} de ${aviso.fotos.length}`;
      img.loading = 'lazy';
      img.decoding = 'async';
      return img;
    });
    const cargarFoto = (i: number) => {
      const img = imgs[i];
      if (img && !img.src) img.src = img.dataset.src!;
    };
    cargarFoto(0);
    pista.append(...imgs);
    caja.append(pista);
    if (aviso.fotos.length > 1) {
      const contador = el('span', 'absolute bottom-2 right-2 bg-black/55 text-white text-xs px-2 py-0.5 rounded-full', `1 / ${aviso.fotos.length}`);
      const boton = (dir: number, etiqueta: string, simbolo: string) => {
        const b = el('button', `absolute top-1/2 -translate-y-1/2 ${dir < 0 ? 'left-2' : 'right-2'} w-8 h-8 rounded-full bg-white/85 text-primary font-bold shadow hover:bg-white`, simbolo);
        b.type = 'button';
        b.setAttribute('aria-label', etiqueta);
        b.addEventListener('click', () => {
          const destino = Math.round(pista.scrollLeft / pista.clientWidth) + dir;
          cargarFoto(destino);
          pista.scrollBy({ left: dir * pista.clientWidth, behavior: 'smooth' });
        });
        return b;
      };
      pista.addEventListener('scroll', () => {
        const actual = Math.round(pista.scrollLeft / pista.clientWidth);
        contador.textContent = `${actual + 1} / ${aviso.fotos.length}`;
        // Al deslizar con el dedo, pide la foto que aparece y la siguiente.
        cargarFoto(actual);
        cargarFoto(actual + 1);
      }, { passive: true });
      caja.append(boton(-1, 'Foto anterior', '‹'), boton(1, 'Foto siguiente', '›'), contador);
    }
    return caja;
  }

  function tarjeta(aviso: AvisoPublico) {
    const cat = categorias.find(c => c.id === aviso.categoria);
    const art = el('article', 'guia-aviso bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col border border-sky-100');
    art.dataset.categoria = aviso.categoria;
    const cuerpo = el('div', 'p-6 flex flex-col flex-1');
    cuerpo.append(
      el('span', 'self-start border border-secondary text-secondary text-xs font-medium px-2.5 py-0.5 rounded-full mb-3', cat?.nombre || ''),
      el('h3', 'font-heading text-base font-bold text-azul leading-snug mb-1', aviso.nombre),
      el('p', 'text-xs text-primary font-medium mb-3', `📍 ${aviso.sector}`),
    );
    const { destacadas, detalles } = describirCaracteristicas(aviso.categoria, aviso.caracteristicas);
    if (destacadas.length) {
      const chips = el('ul', 'flex flex-wrap gap-1.5 mb-3');
      chips.setAttribute('aria-label', 'Características principales');
      destacadas.forEach(t => chips.append(el('li', 'bg-sky-50 text-azul text-xs font-medium px-2.5 py-1 rounded-full', t)));
      cuerpo.append(chips);
    }
    cuerpo.append(el('p', 'font-body text-gray-500 text-sm leading-relaxed flex-1 whitespace-pre-line', aviso.descripcion));
    if (detalles.length) {
      const mas = el('details', 'mt-4 group');
      const resumen = el('summary', 'cursor-pointer select-none text-sm font-medium text-primary hover:underline list-none [&::-webkit-details-marker]:hidden');
      resumen.append(el('span', 'group-open:hidden', `Más detalles (${detalles.length}) ▾`), el('span', 'hidden group-open:inline', 'Menos detalles ▴'));
      const lista = el('dl', 'mt-3 space-y-2 text-sm');
      detalles.forEach(d => {
        const fila = el('div', '');
        fila.append(el('dt', 'text-xs text-gray-400', d.etiqueta), el('dd', 'text-gray-700', d.valor));
        lista.append(fila);
      });
      mas.append(resumen, lista);
      cuerpo.append(mas);
    }
    // Contacto: WhatsApp, sitio web e Instagram (los que tenga el aviso).
    const enlaces: HTMLAnchorElement[] = [];
    const enlace = (texto: string, href: string, clases: string, titulo?: string) => {
      const a = el('a', `inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-full transition ${clases}`, texto);
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener noreferrer nofollow ugc'; // enlaces de terceros
      if (titulo) a.title = titulo;
      enlaces.push(a);
    };
    if (aviso.whatsapp) {
      const mensaje = `Hola, vi tu aviso "${aviso.nombre}" en la Guía del Litoral de Conecta Litoral.`;
      enlace('WhatsApp', `https://wa.me/${encodeURIComponent(aviso.whatsapp)}?text=${encodeURIComponent(mensaje)}`,
        'bg-secondary/10 text-azul hover:bg-secondary/20');
    }
    // La API solo entrega URLs http(s) ya validadas; se revisa igual antes de usarla como enlace.
    if (aviso.web && /^https?:\/\//i.test(aviso.web)) {
      let dominio = aviso.web;
      try { dominio = new URL(aviso.web).hostname.replace(/^www\./, ''); } catch { /* se deja tal cual */ }
      enlace('Sitio web ↗', aviso.web, 'bg-primary/10 text-primary hover:bg-primary/20', dominio);
    }
    if (aviso.instagram) {
      enlace('Instagram ↗', `https://www.instagram.com/${encodeURIComponent(aviso.instagram)}/`,
        'bg-pink-50 text-pink-600 hover:bg-pink-100', `@${aviso.instagram}`);
    }
    if (enlaces.length) {
      const pie = el('div', 'mt-5 pt-4 border-t border-gray-100 flex flex-wrap gap-2');
      pie.append(...enlaces);
      cuerpo.append(pie);
    }
    art.append(galeria(aviso, cat), cuerpo);
    return art;
  }

  async function cargarAvisos() {
    try {
      const res = await fetch('/api/avisos', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const avisos: AvisoPublico[] = await res.json();
      if (!Array.isArray(avisos) || avisos.length === 0) return;
      hayAvisosReales = true;
      contenedor.replaceChildren(...avisos.map(tarjeta));
      aplicar(filtroActual);
    } catch {
      // Sin API (por ejemplo en `astro dev`): se quedan las tarjetas de ejemplo.
    }
  }
  // Los avisos se piden recién cuando la Guía está por aparecer en pantalla:
  // quien abre el sitio y no baja hasta la Guía no gasta cuota de la API.
  if ('IntersectionObserver' in window) {
    const observador = new IntersectionObserver(entradas => {
      if (entradas.some(e => e.isIntersecting)) {
        observador.disconnect();
        cargarAvisos();
      }
    }, { rootMargin: '800px 0px' });
    observador.observe(seccion);
  } else {
    cargarAvisos();
  }

  const form = document.getElementById('form-aviso') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const texto = [
      'Hola, quiero publicar un aviso en la Guía del Litoral:',
      `Nombre: ${d.get('nombre')}`,
      `Teléfono: ${d.get('telefono')}`,
      `Categoría: ${d.get('categoria')}`,
      `Sector: ${d.get('sector')}`,
      `Descripción: ${d.get('descripcion')}`,
    ].join('\n');
    window.open(`https://wa.me/56927698014?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
    form.reset();
  });
</script>
