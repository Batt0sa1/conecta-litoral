---
// "La Fundación": Quiénes somos, Qué hacemos, Pilares y Valores en pestañas.
// Sin JavaScript se ven todas las secciones una debajo de otra; con JavaScript, como pestañas.
// Los enlaces antiguos (#quienes-somos, #que-hacemos) abren directamente su pestaña.
import QuienesSomos from './QuienesSomos.astro';
import QueHacemos from './QueHacemos.astro';
import Pilares from './Pilares.astro';
import Valores from './Valores.astro';

const pestanas = [
  { id: 'quienes-somos', titulo: 'Quiénes somos' },
  { id: 'que-hacemos', titulo: '¿Qué hacemos?' },
  { id: 'pilares', titulo: 'Pilares' },
  { id: 'valores', titulo: 'Valores' },
];
---

<section id="fundacion" class="py-20 px-4 bg-sky-50/60 scroll-mt-16">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-heading text-3xl sm:text-4xl font-bold text-primary text-center mb-4">La Fundación</h2>
    <p class="text-center text-gray-500 mb-10 font-body max-w-xl mx-auto">
      Quiénes somos, qué hacemos y lo que nos mueve.
    </p>

    <div class="flex justify-center mb-10">
      <div role="tablist" aria-label="Información de la fundación"
        class="fundacion-tabs inline-flex max-w-full overflow-x-auto gap-1 bg-white border border-sky-100 rounded-full p-1 shadow-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {pestanas.map((p, i) => (
          <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={p.id} data-pestana={p.id}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
            class="shrink-0 whitespace-nowrap font-heading text-sm font-semibold px-4 sm:px-5 py-2.5 rounded-full transition text-azul hover:bg-sky-50 aria-selected:bg-primary aria-selected:text-white aria-selected:hover:bg-primary">
            {p.titulo}
          </button>
        ))}
      </div>
    </div>

    <div id="quienes-somos" role="tabpanel" aria-labelledby="tab-quienes-somos" class="fundacion-panel scroll-mt-24">
      <QuienesSomos />
    </div>
    <div id="que-hacemos" role="tabpanel" aria-labelledby="tab-que-hacemos" class="fundacion-panel scroll-mt-24 mt-16">
      <QueHacemos />
    </div>
    <div id="pilares" role="tabpanel" aria-labelledby="tab-pilares" class="fundacion-panel scroll-mt-24 mt-16">
      <Pilares />
    </div>
    <div id="valores" role="tabpanel" aria-labelledby="tab-valores" class="fundacion-panel scroll-mt-24 mt-16">
      <Valores />
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.fundacion-tabs [role="tab"]')];
  const paneles = [...document.querySelectorAll<HTMLElement>('.fundacion-panel')];

  function activar(id: string, enfocar = false) {
    tabs.forEach(t => {
      const activa = t.dataset.pestana === id;
      t.setAttribute('aria-selected', String(activa));
      t.tabIndex = activa ? 0 : -1;
      if (activa && enfocar) t.focus({ preventScroll: true });
      if (activa) {
        // En celulares la barra de pestañas se desplaza de lado; se mueve solo la barra, nunca la página.
        const barra = t.parentElement!;
        const izq = t.offsetLeft - barra.offsetLeft;
        if (izq < barra.scrollLeft || izq + t.offsetWidth > barra.scrollLeft + barra.clientWidth) {
          barra.scrollTo({ left: izq - 8 });
        }
      }
    });
    paneles.forEach(p => {
      p.hidden = p.id !== id;
      p.classList.remove('mt-16'); // en modo pestañas no hace falta separación entre paneles
    });
  }

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => activar(t.dataset.pestana!));
    // Teclado: flechas, Inicio y Fin para moverse entre pestañas (patrón WAI-ARIA).
    t.addEventListener('keydown', e => {
      const ir = (j: number) => { e.preventDefault(); activar(tabs[(j + tabs.length) % tabs.length].dataset.pestana!, true); };
      if (e.key === 'ArrowRight') ir(i + 1);
      else if (e.key === 'ArrowLeft') ir(i - 1);
      else if (e.key === 'Home') ir(0);
      else if (e.key === 'End') ir(tabs.length - 1);
    });
  });

  // Abre la pestaña del enlace (#quienes-somos, #que-hacemos, #pilares, #valores).
  function desdeHash() {
    const id = location.hash.slice(1);
    if (paneles.some(p => p.id === id)) {
      activar(id);
      document.getElementById('fundacion')?.scrollIntoView();
      return true;
    }
    return false;
  }
  if (!desdeHash()) activar(tabs[0].dataset.pestana!);
  window.addEventListener('hashchange', desdeHash);
</script>
