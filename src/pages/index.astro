---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Carrusel from '../components/Carrusel.astro';
import Categorias from '../components/Categorias.astro';
import Guia from '../components/Guia.astro';
import Asesorias from '../components/Asesorias.astro';
import Galeria from '../components/Galeria.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout>
  <Navbar />
  <main>
    <Carrusel />
    <Categorias />
    <Guia />
    <Asesorias />
    <Galeria />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<script is:inline>
  // Enlaces antiguos a secciones que ahora son páginas propias (ej: /#quienes-somos → /quienes-somos/).
  (function () {
    var paginas = { 'quienes-somos': 'quienes-somos', fundacion: 'quienes-somos', 'que-hacemos': 'que-hacemos', pilares: 'pilares', valores: 'valores' };
    function redirigir() {
      var destino = paginas[location.hash.slice(1)];
      if (destino) location.replace(location.pathname.replace(/[^/]*$/, '') + destino + '/');
    }
    redirigir();
    window.addEventListener('hashchange', redirigir);
  })();
</script>
