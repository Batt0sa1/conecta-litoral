---
// Panel de administración de la Guía del Litoral.
// Habla con /api/admin/* (Pages Functions en functions/). Ingreso con la contraseña ADMIN_PASSWORD.
import Layout from '../layouts/Layout.astro';
import { categorias } from '../data/categorias';
import { MAX_DIAPOSITIVAS } from '../data/carrusel';

const base = import.meta.env.BASE_URL;
const campo = 'bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40';
const input = `w-full ${campo}`;
const label = 'block text-azul text-sm font-medium mb-1.5';
const pestanasPanel = [
  { vista: 'lista', nombre: 'Avisos' },
  { vista: 'carrusel', nombre: 'Carrusel de portada' },
];
---

<Layout title="Panel · Guía del Litoral" description="Panel de administración de la Guía del Litoral." noindex>
  <div class="min-h-screen bg-gradient-to-b from-sky-50 to-violet-50">
    <!-- Ingreso -->
    <section id="vista-login" class="hidden min-h-screen flex items-center justify-center px-4">
      <form id="form-login" class="w-full max-w-sm bg-white rounded-2xl shadow-sm border border-sky-100 p-8">
        <img src={`${base}images/logo.png`} alt="Conecta Litoral" class="h-16 w-auto mx-auto mb-4" />
        <h1 class="font-heading text-xl font-bold text-primary text-center mb-1">Panel de la Guía</h1>
        <p class="text-gray-500 text-sm text-center mb-6">Ingresa la contraseña para administrar los avisos.</p>
        <label for="login-password" class={label}>Contraseña</label>
        <input id="login-password" type="password" required autocomplete="current-password" class={input} />
        <p id="login-error" class="hidden mt-3 text-sm text-red-600" role="alert"></p>
        <button type="submit" class="mt-5 w-full bg-primary text-white font-heading font-semibold py-3 rounded-full hover:bg-azul transition disabled:opacity-60">
          Entrar
        </button>
        <a href={base} class="block text-center text-secondary text-sm mt-4 hover:underline">← Volver al sitio</a>
      </form>
    </section>

    <!-- Lista de avisos -->
    <section id="vista-lista" class="hidden">
      <header class="bg-white border-b border-sky-100 sticky top-0 z-20">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <img src={`${base}images/logo.png`} alt="" class="h-10 w-auto" />
            <span class="font-heading font-bold text-primary truncate hidden sm:inline">Panel</span>
          </div>
          <nav class="flex gap-1 bg-sky-50 rounded-full p-1" aria-label="Secciones del panel">
            {pestanasPanel.map(p => (
              <button type="button" data-ir-vista={p.vista} aria-current={p.vista === 'lista' ? 'page' : undefined}
                class="whitespace-nowrap text-xs sm:text-sm font-heading font-semibold px-3 sm:px-4 py-1.5 rounded-full text-azul aria-[current=page]:bg-primary aria-[current=page]:text-white">
                {p.nombre}
              </button>
            ))}
          </nav>
          <div class="flex items-center gap-2 shrink-0">
            <a href={`${base}#guia`} target="_blank" class="hidden md:inline text-sm text-secondary hover:underline">Ver sitio</a>
            <button id="btn-salir" type="button" class="text-sm text-gray-500 hover:text-primary px-2 sm:px-3 py-2">Salir</button>
          </div>
        </div>
      </header>

      <div class="max-w-5xl mx-auto px-4 py-8">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-6">
          <button id="btn-nuevo" type="button" class="bg-primary text-white font-heading font-semibold px-6 py-3 rounded-full hover:bg-azul transition shadow-sm">
            + Nuevo aviso
          </button>
          <div class="flex gap-3 flex-1">
            <input id="buscar" type="search" placeholder="Buscar por nombre o sector…" class={`${campo} flex-1 min-w-0`} />
            <select id="filtro-categoria" class={`${campo} w-36 sm:w-56 shrink-0`} aria-label="Filtrar por categoría">
              <option value="">Todas</option>
              {categorias.map(c => <option value={c.id}>{c.nombre}</option>)}
            </select>
          </div>
        </div>
        <p id="resumen" class="text-sm text-gray-500 mb-4"></p>
        <div id="lista" class="space-y-3"></div>
        <p id="lista-vacia" class="hidden text-center text-gray-500 bg-white border border-dashed border-sky-200 rounded-2xl py-12 px-4">
          No hay avisos todavía. Pulsa <strong class="text-primary">+ Nuevo aviso</strong> para crear el primero.
        </p>
      </div>
    </section>

    <!-- Editor -->
    <section id="vista-editor" class="hidden">
      <header class="bg-white border-b border-sky-100 sticky top-0 z-20">
        <div class="max-w-3xl mx-auto px-4 h-16 flex items-center justify-between">
          <button id="btn-volver" type="button" class="text-sm text-secondary hover:underline">← Volver a la lista</button>
          <span id="editor-titulo" class="font-heading font-bold text-primary">Nuevo aviso</span>
        </div>
      </header>

      <form id="form-editor" class="max-w-3xl mx-auto px-4 py-8 space-y-5" novalidate>
        <div class="bg-white rounded-2xl border border-sky-100 shadow-sm p-6 space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="e-categoria" class={label}>Categoría *</label>
              <select id="e-categoria" name="categoria" required class={input}>
                <option value="" disabled selected>Elige una categoría</option>
                {categorias.map(c => <option value={c.id}>{c.nombre}</option>)}
              </select>
            </div>
            <div>
              <label for="e-sector" class={label}>Sector / comuna *</label>
              <input id="e-sector" name="sector" required maxlength="120" placeholder="Ej: Mirasol, Algarrobo" class={input} />
            </div>
          </div>
          <div>
            <label for="e-nombre" class={label}>Nombre del aviso *</label>
            <input id="e-nombre" name="nombre" required maxlength="120" placeholder="Ej: Cabaña frente al mar para 4 personas" class={input} />
          </div>
          <div>
            <label for="e-descripcion" class={label}>Descripción *</label>
            <textarea id="e-descripcion" name="descripcion" required maxlength="2000" rows="5"
              placeholder="Qué ofrece, capacidad, horarios, precio si corresponde…" class={`${input} resize-y`}></textarea>
          </div>
          <div>
            <label for="e-whatsapp" class={label}>WhatsApp de contacto</label>
            <input id="e-whatsapp" name="whatsapp" type="tel" maxlength="20" placeholder="+56 9 1234 5678" class={input} />
            <p class="text-xs text-gray-400 mt-1">Los visitantes verán un botón para escribirle directo. Déjalo vacío si no quieren contacto.</p>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="e-web" class={label}>Sitio web</label>
              <input id="e-web" name="web" type="text" inputmode="url" autocomplete="off" maxlength="200" placeholder="Ej: www.mirestaurant.cl" class={input} />
            </div>
            <div>
              <label for="e-instagram" class={label}>Instagram</label>
              <input id="e-instagram" name="instagram" type="text" autocomplete="off" maxlength="120" placeholder="Ej: @mirestaurant" class={input} />
            </div>
          </div>
          <p class="text-xs text-gray-400 -mt-2">Opcionales. Se pueden pegar tal cual: el enlace completo o solo el nombre.</p>
        </div>

        <div id="caract-card" class="hidden bg-white rounded-2xl border border-sky-100 shadow-sm p-6">
          <h2 class="font-heading font-semibold text-azul">Características</h2>
          <p class="text-xs text-gray-400 mb-5">Cambian según la categoría y se muestran en el aviso. Los campos con * son obligatorios; el resto, si no aplica, déjalo vacío.</p>
          <div id="caract" class="grid sm:grid-cols-2 gap-5"></div>
        </div>

        <div class="bg-white rounded-2xl border border-sky-100 shadow-sm p-6">
          <div class="flex items-center justify-between gap-3 mb-1">
            <h2 class="font-heading font-semibold text-azul">Fotos</h2>
            <span id="fotos-contador" class="text-xs text-gray-400"></span>
          </div>
          <p class="text-xs text-gray-400 mb-4">La primera foto es la portada. Usa las flechas para cambiar el orden.</p>
          <div id="fotos" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
          <label id="fotos-agregar" class="mt-4 flex items-center justify-center gap-2 border-2 border-dashed border-primary/30 rounded-xl py-6 text-primary font-medium text-sm cursor-pointer hover:bg-primary/5 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Agregar fotos
            <input id="fotos-input" type="file" accept="image/*" multiple class="sr-only" />
          </label>
        </div>

        <div class="bg-white rounded-2xl border border-sky-100 shadow-sm p-6">
          <label class="flex items-start gap-3 cursor-pointer">
            <input id="e-publicado" type="checkbox" checked class="mt-1 accent-primary w-5 h-5 shrink-0" />
            <span>
              <span class="block font-medium text-azul">Publicado</span>
              <span class="block text-xs text-gray-400">Si lo desmarcas, el aviso queda guardado pero no se ve en el sitio.</span>
            </span>
          </label>
        </div>

        <p id="editor-error" class="hidden text-sm text-red-600 bg-red-50 rounded-xl px-4 py-3" role="alert"></p>

        <div class="flex flex-col-reverse sm:flex-row gap-3 sm:justify-end">
          <button id="btn-cancelar" type="button" class="px-6 py-3 rounded-full text-gray-500 hover:text-primary">Cancelar</button>
          <button id="btn-guardar" type="submit" class="bg-primary text-white font-heading font-semibold px-8 py-3 rounded-full hover:bg-azul transition shadow-sm disabled:opacity-60">
            Guardar aviso
          </button>
        </div>
      </form>
    </section>

    <!-- Carrusel de portada -->
    <section id="vista-carrusel" class="hidden">
      <header class="bg-white border-b border-sky-100 sticky top-0 z-20">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <img src={`${base}images/logo.png`} alt="" class="h-10 w-auto" />
            <span class="font-heading font-bold text-primary truncate hidden sm:inline">Panel</span>
          </div>
          <nav class="flex gap-1 bg-sky-50 rounded-full p-1" aria-label="Secciones del panel">
            {pestanasPanel.map(p => (
              <button type="button" data-ir-vista={p.vista} aria-current={p.vista === 'carrusel' ? 'page' : undefined}
                class="whitespace-nowrap text-xs sm:text-sm font-heading font-semibold px-3 sm:px-4 py-1.5 rounded-full text-azul aria-[current=page]:bg-primary aria-[current=page]:text-white">
                {p.nombre}
              </button>
            ))}
          </nav>
          <a href={`${base}#inicio`} target="_blank" class="hidden md:inline text-sm text-secondary hover:underline shrink-0">Ver portada</a>
        </div>
      </header>

      <div class="max-w-5xl mx-auto px-4 py-8 pb-32">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-6">
          <div>
            <h1 class="font-heading text-xl font-bold text-primary">Carrusel de portada</h1>
            <p class="text-sm text-gray-500 mt-1 max-w-2xl">
              Las imágenes que se ven al abrir el sitio. Cambia o agrega fotos, ordénalas y pulsa <strong>Guardar cambios</strong>.
            </p>
          </div>
          <span id="carr-estado" class="self-start shrink-0 text-xs font-medium px-3 py-1 rounded-full"></span>
        </div>

        <div id="carr-lista" class="space-y-4"></div>

        <label id="carr-agregar" class="mt-4 flex items-center justify-center gap-2 border-2 border-dashed border-primary/30 rounded-2xl py-6 text-primary font-medium text-sm cursor-pointer hover:bg-primary/5 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          Agregar imagen
          <input id="carr-agregar-input" type="file" accept="image/*" class="sr-only" />
        </label>
        <p class="text-xs text-gray-400 mt-2 text-center">Máximo {MAX_DIAPOSITIVAS} imágenes. Horizontales o verticales: siempre se muestran completas, sin recortar.</p>

        <div class="mt-10 pt-6 border-t border-sky-100 text-center">
          <button id="carr-restaurar" type="button" class="text-sm text-red-500 hover:underline">Restaurar el carrusel original</button>
        </div>
      </div>

      <!-- Barra para guardar -->
      <div class="fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur border-t border-sky-100">
        <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
          <p id="carr-aviso" class="text-sm text-gray-500" role="status"></p>
          <div class="flex gap-2 shrink-0">
            <button id="carr-descartar" type="button" class="px-4 py-2.5 rounded-full text-sm text-gray-500 hover:text-primary disabled:opacity-40" disabled>Descartar</button>
            <button id="carr-guardar" type="button" class="bg-primary text-white font-heading font-semibold px-6 py-2.5 rounded-full text-sm hover:bg-azul transition disabled:opacity-40" disabled>Guardar cambios</button>
          </div>
        </div>
      </div>
    </section>

    <div id="aviso-flotante" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 bg-azul text-white text-sm px-5 py-3 rounded-full shadow-lg" role="status"></div>
  </div>
</Layout>

<script>
  import { categorias } from '../data/categorias';
  import { camposPorCategoria, type Campo, type Caracteristicas } from '../data/caracteristicas';
  import { ENLACES_INTERNOS, MAX_DIAPOSITIVAS, type Diapositiva } from '../data/carrusel';

  interface Aviso {
    id: string;
    categoria: string;
    nombre: string;
    sector: string;
    descripcion: string;
    whatsapp: string;
    web?: string;
    instagram?: string;
    fotos: string[];
    caracteristicas?: Caracteristicas;
    publicado: boolean;
    actualizado: string;
  }

  const MAX_FOTOS = 8;
  // Optimización de fotos en el navegador, antes de subirlas:
  const LADO_MAX = 1280; // px del lado más largo (en el sitio se ven a ~400px; sobra para pantallas retina)
  const PESO_OBJETIVO = 350 * 1024; // si pesa más, se baja la calidad hasta llegar a esto
  const CALIDADES = [0.82, 0.74, 0.66, 0.58];

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const vistas = { login: $('vista-login'), lista: $('vista-lista'), editor: $('vista-editor'), carrusel: $('vista-carrusel') };
  const nombreCategoria = Object.fromEntries(categorias.map(c => [c.id, c.nombre]));

  let avisos: Aviso[] = [];
  let editando: Aviso | null = null;
  let fotos: string[] = [];
  let subiendo = 0;

  function mostrar(vista: keyof typeof vistas) {
    Object.entries(vistas).forEach(([k, v]) => v.classList.toggle('hidden', k !== vista));
    window.scrollTo(0, 0);
  }

  function notificar(texto: string) {
    const n = $('aviso-flotante');
    n.textContent = texto;
    n.classList.remove('hidden');
    clearTimeout((n as any)._t);
    (n as any)._t = setTimeout(() => n.classList.add('hidden'), 3000);
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, clases = '', texto?: string) {
    const e = document.createElement(tag);
    if (clases) e.className = clases;
    if (texto !== undefined) e.textContent = texto;
    return e;
  }

  class SesionExpirada extends Error {}

  async function api<T = any>(ruta: string, opciones: RequestInit = {}): Promise<T> {
    const headers = new Headers(opciones.headers);
    headers.set('X-Requested-With', 'panel');
    if (opciones.body && typeof opciones.body === 'string') headers.set('Content-Type', 'application/json');
    const res = await fetch(ruta, { ...opciones, headers, credentials: 'same-origin' });
    const datos = await res.json().catch(() => ({}));
    if (res.status === 401 && ruta !== '/api/admin/login') {
      mostrar('login');
      throw new SesionExpirada(datos.error || 'Tu sesión expiró.');
    }
    if (!res.ok) throw new Error(datos.error || `Error ${res.status}. Intenta de nuevo.`);
    return datos as T;
  }

  // ---------- Ingreso ----------

  $('form-login').addEventListener('submit', async e => {
    e.preventDefault();
    const boton = (e.currentTarget as HTMLFormElement).querySelector('button') as HTMLButtonElement;
    const error = $('login-error');
    error.classList.add('hidden');
    boton.disabled = true;
    try {
      await api('/api/admin/login', {
        method: 'POST',
        body: JSON.stringify({ password: $<HTMLInputElement>('login-password').value }),
      });
      $<HTMLInputElement>('login-password').value = '';
      await cargarLista();
    } catch (err) {
      error.textContent = (err as Error).message;
      error.classList.remove('hidden');
    } finally {
      boton.disabled = false;
    }
  });

  $('btn-salir').addEventListener('click', async () => {
    await api('/api/admin/logout', { method: 'POST' }).catch(() => {});
    mostrar('login');
  });

  // ---------- Lista ----------

  async function cargarLista() {
    avisos = await api<Aviso[]>('/api/admin/avisos');
    pintarLista();
    mostrar('lista');
  }

  function pintarLista() {
    const q = $<HTMLInputElement>('buscar').value.trim().toLowerCase();
    const cat = $<HTMLSelectElement>('filtro-categoria').value;
    const visibles = avisos.filter(a =>
      (!cat || a.categoria === cat) &&
      (!q || `${a.nombre} ${a.sector}`.toLowerCase().includes(q)),
    );
    const publicados = avisos.filter(a => a.publicado).length;
    $('resumen').textContent = avisos.length
      ? `${avisos.length} aviso${avisos.length === 1 ? '' : 's'} · ${publicados} publicado${publicados === 1 ? '' : 's'}`
      : '';
    $('lista-vacia').classList.toggle('hidden', avisos.length > 0);
    $('lista').replaceChildren(...visibles.map(filaAviso));
    if (avisos.length && !visibles.length) {
      $('lista').append(el('p', 'text-center text-gray-500 py-8', 'Ningún aviso coincide con la búsqueda.'));
    }
  }

  function filaAviso(a: Aviso) {
    const fila = el('div', 'bg-white rounded-2xl border border-sky-100 shadow-sm p-4 flex flex-col sm:flex-row sm:items-center gap-4');
    const izq = el('div', 'flex items-center gap-4 min-w-0 flex-1');
    const miniatura = el('div', 'w-20 h-20 rounded-xl overflow-hidden bg-gradient-to-br from-sky-100 to-violet-100 shrink-0 flex items-center justify-center text-primary/40 text-xs');
    if (a.fotos[0]) {
      const img = el('img', 'w-full h-full object-cover');
      img.src = `/api/fotos/${a.fotos[0]}`;
      img.alt = '';
      img.loading = 'lazy';
      miniatura.append(img);
    } else {
      miniatura.textContent = 'Sin foto';
    }
    const datos = el('div', 'min-w-0');
    const estado = el('span',
      `inline-block text-xs font-medium px-2 py-0.5 rounded-full mb-1 ${a.publicado ? 'bg-secondary/15 text-azul' : 'bg-gray-100 text-gray-500'}`,
      a.publicado ? 'Publicado' : 'Oculto');
    datos.append(
      estado,
      el('p', 'font-heading font-semibold text-azul truncate', a.nombre),
      el('p', 'text-xs text-gray-500 truncate', `${nombreCategoria[a.categoria] || a.categoria} · ${a.sector} · ${a.fotos.length} foto${a.fotos.length === 1 ? '' : 's'}`),
    );
    izq.append(miniatura, datos);

    const acciones = el('div', 'flex gap-2 shrink-0');
    const boton = (texto: string, clases: string, accion: () => void) => {
      const b = el('button', `text-sm font-medium px-4 py-2 rounded-full transition ${clases}`, texto);
      b.type = 'button';
      b.addEventListener('click', accion);
      return b;
    };
    acciones.append(
      boton('Editar', 'bg-primary/10 text-primary hover:bg-primary/20', () => abrirEditor(a)),
      boton(a.publicado ? 'Ocultar' : 'Publicar', 'bg-sky-50 text-azul hover:bg-sky-100', () => cambiarPublicado(a)),
      boton('Borrar', 'text-red-500 hover:bg-red-50', () => borrar(a)),
    );
    fila.append(izq, acciones);
    return fila;
  }

  async function cambiarPublicado(a: Aviso) {
    try {
      const nuevo = await api<Aviso>(`/api/admin/avisos/${a.id}`, {
        method: 'PUT',
        body: JSON.stringify({ ...a, publicado: !a.publicado }),
      });
      avisos = avisos.map(x => (x.id === a.id ? nuevo : x));
      pintarLista();
      notificar(nuevo.publicado ? 'Aviso publicado.' : 'Aviso oculto.');
    } catch (err) {
      if (!(err instanceof SesionExpirada)) alert((err as Error).message);
    }
  }

  async function borrar(a: Aviso) {
    if (!confirm(`¿Borrar el aviso "${a.nombre}"? Se borrarán también sus fotos. Esto no se puede deshacer.`)) return;
    try {
      await api(`/api/admin/avisos/${a.id}`, { method: 'DELETE' });
      avisos = avisos.filter(x => x.id !== a.id);
      pintarLista();
      notificar('Aviso borrado.');
    } catch (err) {
      if (!(err instanceof SesionExpirada)) alert((err as Error).message);
    }
  }

  $('buscar').addEventListener('input', pintarLista);
  $('filtro-categoria').addEventListener('change', pintarLista);
  $('btn-nuevo').addEventListener('click', () => abrirEditor(null));

  // ---------- Editor ----------

  const form = $<HTMLFormElement>('form-editor');
  const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  // ---------- Características según la categoría ----------

  const CLASE_CAMPO = 'w-full bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40';

  function controlCampo(c: Campo, valor: unknown): HTMLElement {
    const idInput = `c-${c.id}`;
    const caja = el('div', c.tipo === 'multi' ? 'sm:col-span-2' : '');
    caja.dataset.campo = c.id;
    const titulo = el('label', 'block text-azul text-sm font-medium mb-1.5', c.etiqueta + (c.requerido ? ' *' : ''));

    if (c.tipo === 'si_no') {
      const fila = el('label', 'flex items-center gap-3 cursor-pointer sm:mt-7');
      const check = el('input', 'accent-primary w-5 h-5 shrink-0');
      check.type = 'checkbox';
      check.id = idInput;
      check.checked = valor === true;
      fila.append(check, el('span', 'text-sm text-azul font-medium', c.etiqueta));
      caja.append(fila);
    } else if (c.tipo === 'multi') {
      titulo.removeAttribute('for');
      caja.append(titulo);
      const chips = el('div', 'flex flex-wrap gap-2');
      const elegidas = Array.isArray(valor) ? valor : [];
      c.opciones!.forEach(o => {
        const chip = el('label', 'cursor-pointer');
        const check = el('input', 'peer sr-only');
        check.type = 'checkbox';
        check.value = o;
        check.checked = elegidas.includes(o);
        chip.append(check, el('span',
          'inline-block select-none px-3 py-1.5 rounded-full border border-sky-200 text-sm text-gray-600 transition peer-checked:bg-primary peer-checked:border-primary peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-primary/40',
          o));
        chips.append(chip);
      });
      caja.append(chips);
    } else {
      titulo.setAttribute('for', idInput);
      caja.append(titulo);
      let control: HTMLInputElement | HTMLSelectElement;
      if (c.tipo === 'opciones') {
        control = el('select', CLASE_CAMPO);
        const vacia = el('option', '', c.requerido ? 'Elige una opción' : 'Sin especificar');
        vacia.value = '';
        control.append(vacia, ...c.opciones!.map(o => {
          const op = el('option', '', o);
          op.value = o;
          return op;
        }));
        control.value = typeof valor === 'string' && c.opciones!.includes(valor) ? valor : '';
      } else {
        control = el('input', CLASE_CAMPO);
        if (c.tipo === 'numero') {
          control.type = 'number';
          control.inputMode = 'numeric';
          control.step = '1';
          if (c.min !== undefined) control.min = String(c.min);
          if (c.max !== undefined) control.max = String(c.max);
          if (c.unidad) control.placeholder = `Cantidad de ${c.unidad[1]}`;
        } else {
          control.type = 'text';
          control.maxLength = c.maxLargo ?? 120;
          if (c.placeholder) control.placeholder = c.placeholder;
        }
        control.value = valor === undefined || valor === null ? '' : String(valor);
      }
      control.id = idInput;
      caja.append(control);
    }
    if (c.ayuda) caja.append(el('p', 'text-xs text-gray-400 mt-1', c.ayuda));
    return caja;
  }

  let categoriaPintada = ''; // categoría de los campos que están en pantalla

  function pintarCaracteristicas(categoria: string, valores: Caracteristicas) {
    categoriaPintada = categoria;
    const campos = camposPorCategoria[categoria] || [];
    $('caract-card').classList.toggle('hidden', campos.length === 0);
    $('caract').replaceChildren(...campos.map(c => controlCampo(c, valores[c.id])));
  }

  function leerCaracteristicas(): Caracteristicas {
    const valores: Caracteristicas = {};
    for (const c of camposPorCategoria[categoriaPintada] || []) {
      const caja = $('caract').querySelector<HTMLElement>(`[data-campo="${c.id}"]`);
      if (!caja) continue;
      if (c.tipo === 'multi') {
        const elegidas = [...caja.querySelectorAll<HTMLInputElement>('input:checked')].map(i => i.value);
        if (elegidas.length) valores[c.id] = elegidas;
      } else if (c.tipo === 'si_no') {
        if ($<HTMLInputElement>(`c-${c.id}`).checked) valores[c.id] = true;
      } else {
        const v = $<HTMLInputElement>(`c-${c.id}`).value.trim();
        if (v) valores[c.id] = c.tipo === 'numero' ? Number(v) : v;
      }
    }
    return valores;
  }

  // Al cambiar de categoría se conservan los datos que también existen en la nueva (ej: horario, formas de pago).
  $('e-categoria').addEventListener('change', () => {
    pintarCaracteristicas(campo('categoria').value, leerCaracteristicas());
  });

  function abrirEditor(a: Aviso | null) {
    editando = a;
    form.reset();
    $('editor-error').classList.add('hidden');
    $('editor-titulo').textContent = a ? 'Editar aviso' : 'Nuevo aviso';
    campo('categoria').value = a?.categoria || '';
    campo('sector').value = a?.sector || '';
    campo('nombre').value = a?.nombre || '';
    campo('descripcion').value = a?.descripcion || '';
    campo('whatsapp').value = a?.whatsapp ? `+${a.whatsapp}` : '';
    campo('web').value = a?.web || '';
    campo('instagram').value = a?.instagram ? `@${a.instagram}` : '';
    $<HTMLInputElement>('e-publicado').checked = a ? a.publicado : true;
    pintarCaracteristicas(a?.categoria || '', a?.caracteristicas || {});
    fotos = a ? [...a.fotos] : [];
    pintarFotos();
    mostrar('editor');
  }

  function cerrarEditor() {
    if (subiendo > 0 && !confirm('Hay fotos subiéndose. ¿Salir igual?')) return;
    mostrar('lista');
  }
  $('btn-volver').addEventListener('click', cerrarEditor);
  $('btn-cancelar').addEventListener('click', cerrarEditor);

  function pintarFotos() {
    const cont = $('fotos');
    cont.replaceChildren(...fotos.map((id, i) => {
      const caja = el('div', 'relative aspect-square rounded-xl overflow-hidden bg-sky-50 group');
      const img = el('img', 'w-full h-full object-cover');
      img.src = `/api/fotos/${id}`;
      img.alt = `Foto ${i + 1}`;
      caja.append(img);
      if (i === 0) caja.append(el('span', 'absolute top-2 left-2 bg-primary text-white text-[10px] font-semibold px-2 py-0.5 rounded-full', 'Portada'));
      const barra = el('div', 'absolute bottom-0 inset-x-0 flex justify-between bg-black/45 p-1');
      const accion = (texto: string, etiqueta: string, fn: () => void, deshabilitado = false) => {
        const b = el('button', 'w-8 h-8 rounded-full text-white hover:bg-white/20 disabled:opacity-30', texto);
        b.type = 'button';
        b.title = etiqueta;
        b.setAttribute('aria-label', etiqueta);
        b.disabled = deshabilitado;
        b.addEventListener('click', fn);
        return b;
      };
      const mover = (d: number) => {
        [fotos[i], fotos[i + d]] = [fotos[i + d], fotos[i]];
        pintarFotos();
      };
      barra.append(
        accion('←', 'Mover a la izquierda', () => mover(-1), i === 0),
        accion('✕', 'Quitar foto', () => { fotos.splice(i, 1); pintarFotos(); }),
        accion('→', 'Mover a la derecha', () => mover(1), i === fotos.length - 1),
      );
      caja.append(barra);
      return caja;
    }));
    for (let i = 0; i < subiendo; i++) {
      cont.append(el('div', 'aspect-square rounded-xl bg-sky-50 border border-dashed border-sky-200 flex items-center justify-center text-xs text-gray-400 animate-pulse', 'Subiendo…'));
    }
    $('fotos-contador').textContent = `${fotos.length} de ${MAX_FOTOS}`;
    $('fotos-agregar').classList.toggle('hidden', fotos.length + subiendo >= MAX_FOTOS);
  }

  const aBlob = (canvas: HTMLCanvasElement, tipo: string, calidad: number) =>
    new Promise<Blob | null>(ok => canvas.toBlob(ok, tipo, calidad));

  /** Formato de salida: WebP si el navegador sabe generarlo (pesa ~30% menos), si no JPEG. */
  let formatoSalida: Promise<string> | null = null;
  function elegirFormato() {
    formatoSalida ??= (async () => {
      const c = document.createElement('canvas');
      c.width = c.height = 2;
      const b = await aBlob(c, 'image/webp', 0.8);
      return b?.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
    })();
    return formatoSalida;
  }

  /**
   * Achica la foto a LADO_MAX px, la convierte a WebP/JPEG y baja la calidad si sigue pesando mucho.
   * Al redibujarla en un canvas se descartan los metadatos (EXIF), incluida la ubicación GPS del celular.
   */
  async function prepararFoto(archivo: File, lado = LADO_MAX, pesoObjetivo = PESO_OBJETIVO): Promise<Blob> {
    const bitmap = await createImageBitmap(archivo).catch(() => null);
    if (!bitmap) throw new Error(`No se pudo leer "${archivo.name}". Prueba con una foto JPG o PNG.`);
    const escala = Math.min(1, lado / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * escala);
    canvas.height = Math.round(bitmap.height * escala);
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.fillStyle = '#ffffff'; // fondo blanco para PNG con transparencia
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();

    const tipo = await elegirFormato();
    let mejor: Blob | null = null;
    for (const calidad of CALIDADES) {
      const blob = await aBlob(canvas, tipo, calidad);
      if (blob && (!mejor || blob.size < mejor.size)) mejor = blob;
      if (mejor && mejor.size <= pesoObjetivo) break;
    }
    if (!mejor) throw new Error(`No se pudo procesar "${archivo.name}".`);
    return mejor;
  }

  const formatoPeso = (bytes: number) =>
    bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1).replace('.', ',')} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;

  $<HTMLInputElement>('fotos-input').addEventListener('change', async e => {
    const input = e.currentTarget as HTMLInputElement;
    const archivos = [...(input.files || [])].slice(0, MAX_FOTOS - fotos.length - subiendo);
    input.value = '';
    await Promise.all(archivos.map(async archivo => {
      subiendo++;
      pintarFotos();
      try {
        const blob = await prepararFoto(archivo);
        const { id } = await api<{ id: string }>('/api/admin/fotos', {
          method: 'POST',
          headers: { 'Content-Type': blob.type },
          body: blob,
        });
        fotos.push(id);
        notificar(`Foto optimizada: ${formatoPeso(archivo.size)} → ${formatoPeso(blob.size)}`);
      } catch (err) {
        if (!(err instanceof SesionExpirada)) alert((err as Error).message);
      } finally {
        subiendo--;
        pintarFotos();
      }
    }));
  });

  // Al corregir cualquier campo se oculta el mensaje de error anterior.
  form.addEventListener('input', () => $('editor-error').classList.add('hidden'));
  form.addEventListener('change', () => $('editor-error').classList.add('hidden'));

  form.addEventListener('submit', async e => {
    e.preventDefault();
    const error = $('editor-error');
    error.classList.add('hidden');
    if (subiendo > 0) {
      error.textContent = 'Espera a que terminen de subirse las fotos.';
      error.classList.remove('hidden');
      return;
    }
    const datos = {
      categoria: campo('categoria').value,
      sector: campo('sector').value,
      nombre: campo('nombre').value,
      descripcion: campo('descripcion').value,
      whatsapp: campo('whatsapp').value,
      web: campo('web').value,
      instagram: campo('instagram').value,
      fotos,
      caracteristicas: leerCaracteristicas(),
      publicado: $<HTMLInputElement>('e-publicado').checked,
    };
    const boton = $<HTMLButtonElement>('btn-guardar');
    boton.disabled = true;
    boton.textContent = 'Guardando…';
    try {
      const guardado = await api<Aviso>(editando ? `/api/admin/avisos/${editando.id}` : '/api/admin/avisos', {
        method: editando ? 'PUT' : 'POST',
        body: JSON.stringify(datos),
      });
      avisos = editando ? avisos.map(x => (x.id === guardado.id ? guardado : x)) : [guardado, ...avisos];
      pintarLista();
      mostrar('lista');
      notificar(editando ? 'Cambios guardados.' : 'Aviso creado.');
    } catch (err) {
      if (!(err instanceof SesionExpirada)) {
        error.textContent = (err as Error).message;
        error.classList.remove('hidden');
      }
    } finally {
      boton.disabled = false;
      boton.textContent = 'Guardar aviso';
    }
  });

  // ---------- Carrusel de portada ----------

  const CARR_LADO = 1600; // px: las fotos del carrusel se ven grandes
  const CARR_PESO = 450 * 1024;
  let carrusel: Diapositiva[] = [];
  let carruselGuardado: Diapositiva[] = [];
  let carrPersonalizado = false;
  let carrSubiendo = 0;
  const carrSucio = () => JSON.stringify(carrusel) !== JSON.stringify(carruselGuardado);

  function actualizarBarraCarrusel() {
    const sucio = carrSucio();
    $<HTMLButtonElement>('carr-guardar').disabled = !sucio || carrSubiendo > 0;
    $<HTMLButtonElement>('carr-descartar').disabled = !sucio;
    $('carr-aviso').textContent = carrSubiendo > 0 ? 'Subiendo foto…' : sucio ? 'Tienes cambios sin guardar.' : 'Todo guardado.';
    const estado = $('carr-estado');
    estado.textContent = carrPersonalizado ? 'Carrusel personalizado' : 'Carrusel original';
    estado.className = `self-start shrink-0 text-xs font-medium px-3 py-1 rounded-full ${carrPersonalizado ? 'bg-secondary/15 text-azul' : 'bg-gray-100 text-gray-500'}`;
    $('carr-agregar').classList.toggle('hidden', carrusel.length + carrSubiendo >= MAX_DIAPOSITIVAS);
    $<HTMLButtonElement>('carr-restaurar').classList.toggle('hidden', !carrPersonalizado);
  }

  async function abrirCarrusel() {
    try {
      const r = await api<{ diapositivas: Diapositiva[]; personalizado: boolean }>('/api/admin/carrusel');
      carrusel = structuredClone(r.diapositivas);
      carruselGuardado = structuredClone(r.diapositivas);
      carrPersonalizado = r.personalizado;
      pintarCarrusel();
      mostrar('carrusel');
    } catch (err) {
      if (!(err instanceof SesionExpirada)) alert((err as Error).message);
    }
  }

  function campoCarrusel(etiqueta: string, control: HTMLElement, ayuda?: string) {
    const caja = el('label', 'block');
    caja.append(el('span', 'block text-azul text-sm font-medium mb-1', etiqueta), control);
    if (ayuda) caja.append(el('span', 'block text-xs text-gray-400 mt-1', ayuda));
    return caja;
  }

  const CLASE_CARR = 'w-full bg-white border border-sky-200 text-gray-800 placeholder-gray-400 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40';

  function tarjetaDiapositiva(d: Diapositiva, i: number) {
    const tarjeta = el('div', 'bg-white rounded-2xl border border-sky-100 shadow-sm p-4 sm:p-5 grid sm:grid-cols-[260px_1fr] gap-5');

    // Imagen + acciones
    const izq = el('div', 'space-y-3');
    const marco = el('div', 'relative aspect-[16/10] rounded-xl overflow-hidden bg-sky-50');
    const img = el('img', 'w-full h-full object-contain');
    img.src = d.imagen;
    img.alt = '';
    marco.append(img, el('span', 'absolute top-2 left-2 bg-primary text-white text-xs font-semibold px-2 py-0.5 rounded-full', String(i + 1)));
    const cambiar = el('label', 'block text-center text-sm text-primary font-medium border border-primary/30 rounded-full py-1.5 cursor-pointer hover:bg-primary/5', 'Cambiar foto');
    const inputFoto = el('input', 'sr-only');
    inputFoto.type = 'file';
    inputFoto.accept = 'image/*';
    inputFoto.addEventListener('change', async () => {
      const archivo = inputFoto.files?.[0];
      if (!archivo) return;
      const nueva = await subirFotoCarrusel(archivo);
      if (nueva) { carrusel[i].imagen = nueva; pintarCarrusel(); }
    });
    cambiar.append(inputFoto);
    izq.append(marco, cambiar);

    // Datos
    const der = el('div', 'flex flex-col gap-4');
    const alt = el('textarea', `${CLASE_CARR} resize-y`);
    alt.rows = 2;
    alt.maxLength = 300;
    alt.value = d.alt;
    alt.placeholder = 'Ej: Grupo de vecinos frente al letrero de Algarrobo';
    alt.addEventListener('input', () => { carrusel[i].alt = alt.value; actualizarBarraCarrusel(); });

    // Enlace al hacer clic: sección/página del sitio u otro enlace
    const destino = el('select', CLASE_CARR);
    const opciones: [string, string][] = [['', 'Ninguno (solo imagen)'], ...ENLACES_INTERNOS.map(e => [e.valor, e.nombre] as [string, string]), ['otro', 'Otro enlace (sitio web)…']];
    opciones.forEach(([v, n]) => { const o = el('option', '', n); o.value = v; destino.append(o); });
    const esInterno = ENLACES_INTERNOS.some(e => e.valor === d.enlace);
    destino.value = !d.enlace ? '' : esInterno ? d.enlace : 'otro';
    const otro = el('input', CLASE_CARR);
    otro.type = 'text';
    otro.maxLength = 200;
    otro.placeholder = 'Ej: www.municipalidad.cl';
    otro.value = esInterno ? '' : d.enlace;
    otro.classList.toggle('hidden', destino.value !== 'otro');
    otro.addEventListener('input', () => { carrusel[i].enlace = otro.value; actualizarBarraCarrusel(); });
    destino.addEventListener('change', () => {
      otro.classList.toggle('hidden', destino.value !== 'otro');
      carrusel[i].enlace = destino.value === 'otro' ? otro.value : destino.value;
      actualizarBarraCarrusel();
    });
    const cajaDestino = el('div', 'space-y-2');
    cajaDestino.append(destino, otro);

    // Orden y quitar
    const acciones = el('div', 'flex flex-wrap gap-2 mt-auto');
    const accion = (texto: string, etiqueta: string, fn: () => void, deshabilitado = false, extra = '') => {
      const b = el('button', `text-sm px-4 py-1.5 rounded-full border border-sky-200 text-azul hover:bg-sky-50 disabled:opacity-30 ${extra}`, texto);
      b.type = 'button';
      b.title = etiqueta;
      b.setAttribute('aria-label', etiqueta);
      b.disabled = deshabilitado;
      b.addEventListener('click', fn);
      return b;
    };
    const intercambiar = (j: number) => { [carrusel[i], carrusel[j]] = [carrusel[j], carrusel[i]]; pintarCarrusel(); };
    acciones.append(
      accion('↑ Subir', 'Subir', () => intercambiar(i - 1), i === 0),
      accion('↓ Bajar', 'Bajar', () => intercambiar(i + 1), i === carrusel.length - 1),
      accion('Quitar', 'Quitar imagen', () => {
        if (carrusel.length === 1) return alert('El carrusel necesita al menos una imagen.');
        if (confirm('¿Quitar esta imagen del carrusel? Se aplica al guardar los cambios.')) { carrusel.splice(i, 1); pintarCarrusel(); }
      }, false, 'text-red-500 border-red-200 hover:bg-red-50 sm:ml-auto'),
    );

    der.append(
      campoCarrusel('Descripción de la imagen', alt,
        'No se muestra en el sitio: la leen las personas con discapacidad visual y Google. Si la imagen es un afiche, escribe aquí su texto.'),
      campoCarrusel('Al hacer clic en la imagen, lleva a', cajaDestino, 'Opcional.'),
      acciones,
    );
    tarjeta.append(izq, der);
    return tarjeta;
  }

  function pintarCarrusel() {
    $('carr-lista').replaceChildren(...carrusel.map(tarjetaDiapositiva));
    for (let k = 0; k < carrSubiendo; k++) {
      $('carr-lista').append(el('div', 'bg-white rounded-2xl border border-dashed border-sky-200 p-6 text-center text-sm text-gray-400 animate-pulse', 'Subiendo foto…'));
    }
    actualizarBarraCarrusel();
  }

  async function subirFotoCarrusel(archivo: File): Promise<string | null> {
    carrSubiendo++;
    actualizarBarraCarrusel();
    try {
      const blob = await prepararFoto(archivo, CARR_LADO, CARR_PESO);
      const { id } = await api<{ id: string }>('/api/admin/fotos', { method: 'POST', headers: { 'Content-Type': blob.type }, body: blob });
      notificar(`Foto optimizada: ${formatoPeso(archivo.size)} → ${formatoPeso(blob.size)}`);
      return `/api/fotos/${id}`;
    } catch (err) {
      if (!(err instanceof SesionExpirada)) alert((err as Error).message);
      return null;
    } finally {
      carrSubiendo--;
      actualizarBarraCarrusel();
    }
  }

  $<HTMLInputElement>('carr-agregar-input').addEventListener('change', async e => {
    const input = e.currentTarget as HTMLInputElement;
    const archivo = input.files?.[0];
    input.value = '';
    if (!archivo || carrusel.length >= MAX_DIAPOSITIVAS) return;
    pintarCarrusel();
    const imagen = await subirFotoCarrusel(archivo);
    if (imagen) {
      carrusel.push({ imagen, alt: '', enlace: '' });
    }
    pintarCarrusel();
  });

  $('carr-guardar').addEventListener('click', async () => {
    const boton = $<HTMLButtonElement>('carr-guardar');
    boton.disabled = true;
    boton.textContent = 'Guardando…';
    try {
      const r = await api<{ diapositivas: Diapositiva[]; personalizado: boolean }>('/api/admin/carrusel', {
        method: 'PUT',
        body: JSON.stringify({ diapositivas: carrusel }),
      });
      carrusel = structuredClone(r.diapositivas);
      carruselGuardado = structuredClone(r.diapositivas);
      carrPersonalizado = r.personalizado;
      pintarCarrusel();
      notificar('Carrusel guardado. Ya se ve en la portada.');
    } catch (err) {
      if (!(err instanceof SesionExpirada)) alert((err as Error).message);
    } finally {
      boton.textContent = 'Guardar cambios';
      actualizarBarraCarrusel();
    }
  });

  $('carr-descartar').addEventListener('click', () => {
    if (!confirm('¿Descartar los cambios que no has guardado?')) return;
    carrusel = structuredClone(carruselGuardado);
    pintarCarrusel();
  });

  $('carr-restaurar').addEventListener('click', async () => {
    if (!confirm('¿Volver al carrusel original? Se borrarán las fotos que subiste para el carrusel.')) return;
    try {
      const r = await api<{ diapositivas: Diapositiva[]; personalizado: boolean }>('/api/admin/carrusel', { method: 'DELETE' });
      carrusel = structuredClone(r.diapositivas);
      carruselGuardado = structuredClone(r.diapositivas);
      carrPersonalizado = r.personalizado;
      pintarCarrusel();
      notificar('Se restauró el carrusel original.');
    } catch (err) {
      if (!(err instanceof SesionExpirada)) alert((err as Error).message);
    }
  });

  // Pestañas del panel: Avisos / Carrusel de portada.
  document.querySelectorAll<HTMLButtonElement>('[data-ir-vista]').forEach(b => {
    b.addEventListener('click', () => {
      if (b.dataset.irVista === 'carrusel') {
        abrirCarrusel();
      } else {
        if (!vistas.carrusel.classList.contains('hidden') && carrSucio() && !confirm('Tienes cambios del carrusel sin guardar. ¿Salir igual?')) return;
        cargarLista();
      }
    });
  });
  window.addEventListener('beforeunload', e => {
    if (!vistas.carrusel.classList.contains('hidden') && carrSucio()) e.preventDefault();
  });

  // ---------- Inicio ----------

  fetch('/api/admin/sesion', { credentials: 'same-origin' })
    .then(r => (r.ok ? cargarLista() : mostrar('login')))
    .catch(() => mostrar('login'));
</script>
